# Cloudflare Pages — HTTP Security Headers (§14)
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://wcs.pstatic.net https://*.googlesyndication.com https://*.googleadservices.com https://adservice.google.com https://*.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://wcs.naver.net https://*.googlesyndication.com https://*.g.doubleclick.net https://*.doubleclick.net https://*.google.com; frame-src https://*.googlesyndication.com https://*.g.doubleclick.net https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-XSS-Protection: 1; mode=block

# 정적 자산 — 1년 immutable 캐시
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — 엣지 캐시 + stale-while-revalidate
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

# Cycle #34: SEO 핵심 파일 캐시 — sitemap·llms·feed (1시간 엣지 캐시 + SWR)
/sitemap-index.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400
/sitemap-0.xml
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400
/sitemap-news.xml
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
# 한글 깨짐 방지 — .txt는 in-band 인코딩 선언이 없어 HTTP charset이 유일 신호.
# Cloudflare 기본 text/plain(charset 없음) + nosniff → 브라우저가 CP949로 오해석 → 정정.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
/feed-issues.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
/atom.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
/feed.json
  Content-Type: application/feed+json; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
/rss/*
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
