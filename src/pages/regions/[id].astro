---
// 지역 허브 — 지자체별 지원금·이슈 집계 페이지 (SEO 감사 2026-08-09 분기 전략 2)
// "4차 민생지원금"류 지역 쿼리 SERP가 게시판 글로 채워진 공백을 겨냥.
// 매칭: 포스트 title/tags, 지원금 title/agency/tags 에 지역명(별칭 포함) 문자열 포함.
// 콘텐츠 2건 미만 지역은 페이지를 생성하지 않는다(thin·noindex-in-sitemap 방지).
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import regions from '@/data/regions.json';
import { issueUrlPath } from '@/lib/issue-url.mjs';
import { passesIssueGate } from '@/lib/issue-gate.mjs';
import { buildCollectionPage } from '@/lib/schema';
import { type GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

interface PostData {
  title: string;
  metaDescription: string;
  category: string;
  tags?: string[];
  publishedAt: string;
}

interface RegionDef {
  id: string;
  name: string;
  full: string;
  aliases: string[];
}

export const getStaticPaths = (async () => {
  // 호이스팅 회피 — Cloudflare prerender server에서 module-scope 변수 접근 실패하므로 함수 내부 정의
  const MIN_ITEMS = 2;
  const postModules = import.meta.glob<{ default: PostData }>('/src/data/issues/*/*.json', {
    eager: true,
  });
  const posts: Array<{ date: string; slug: string; data: PostData }> = [];
  for (const [path, mod] of Object.entries(postModules)) {
    const m = path.match(/\/issues\/(\d{4}-\d{2}-\d{2})\/([^/]+)\.json$/);
    if (!m) continue;
    const date = m[1];
    const slug = m[2];
    if (!date || !slug || slug.startsWith('_')) continue;
    if (!passesIssueGate(date, slug, mod.default)) continue;
    posts.push({ date, slug, data: mod.default });
  }
  posts.sort((a, b) => (a.date < b.date ? 1 : -1));

  const subsidies = await getCollection('subsidies');

  const paths = [];
  for (const region of regions as RegionDef[]) {
    const needles = [region.name, ...region.aliases];
    const matchText = (text: string) => needles.some((n) => text.includes(n));

    const matchedPosts = posts.filter(
      (p) => matchText(p.data.title) || (p.data.tags ?? []).some((t) => matchText(t)),
    );
    const matchedSubsidies = subsidies.filter(
      (s) =>
        matchText(s.data.title) ||
        matchText(s.data.agency ?? '') ||
        (s.data.tags ?? []).some((t: string) => matchText(t)),
    );
    if (matchedPosts.length + matchedSubsidies.length < MIN_ITEMS) continue;

    paths.push({
      params: { id: region.id },
      props: {
        region,
        matchedPosts: matchedPosts.slice(0, 30),
        matchedSubsidies: matchedSubsidies
          .map((s) => ({
            id: s.data.id,
            title: s.data.title,
            agency: s.data.agency,
            category: s.data.category,
          }))
          .slice(0, 20),
      },
    });
  }
  return paths;
}) satisfies GetStaticPaths;

const { region, matchedPosts, matchedSubsidies } = Astro.props;

const pageTitle = `${region.full} 지원금·지원 정책 모음 | 지원금가이드`;
const description = `${region.full} 주민이 받을 수 있는 지원금 ${matchedSubsidies.length}건과 관련 이슈 ${matchedPosts.length}건을 한 페이지에 모았습니다. 대상·금액·신청 방법은 각 글에서 확인하세요.`;

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '지역별', href: '/regions/' },
  { name: region.name, href: `/regions/${region.id}/` },
];

const collectionSchema = buildCollectionPage({
  name: `${region.full} 지원금·지원 정책`,
  description,
  pageUrl: `/regions/${region.id}/`,
  items: [
    ...matchedSubsidies.map((s) => ({ url: `/subsidies/${s.id}/`, name: s.title })),
    ...matchedPosts.map((p) => ({ url: issueUrlPath(p.date, p.slug), name: p.data.title })),
  ],
});
---

<BaseLayout
  title={pageTitle}
  description={description}
  activeNav="/subsidies/"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <section class="region-hero">
    <Container size="wide">
      <a class="back-link" href="/regions/">← 지역별 목록</a>
      <h1 class="title">{region.full} 지원금·지원 정책</h1>
      <p class="lead">
        {region.name} 주민 대상 지원금과 최근 이슈를 모았습니다. 금액·기준일·신청 기간은
        지역 공고로 확정되므로, 각 글의 공식 출처 링크에서 최종 확인하세요.
      </p>
    </Container>
  </section>

  <Container size="wide">
    {matchedPosts.length > 0 && (
      <section class="region-section">
        <h2>최근 이슈 {matchedPosts.length}건</h2>
        <ul class="post-list">
          {matchedPosts.map((p) => (
            <li>
              <a href={issueUrlPath(p.date, p.slug)}>
                <span class="post-date">{p.date}</span>
                <span class="post-title">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {matchedSubsidies.length > 0 && (
      <section class="region-section">
        <h2>지원금 {matchedSubsidies.length}건</h2>
        <ul class="subsidy-grid">
          {matchedSubsidies.map((s) => (
            <li>
              <a class="subsidy-card" href={`/subsidies/${s.id}/`}>
                <span class="subsidy-cat">{s.category}</span>
                <strong class="subsidy-title">{s.title}</strong>
                <span class="subsidy-agency">{s.agency}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="region-section">
      <h2>다른 지역은 어떻게 확인하나요?</h2>
      <p class="region-guide">
        지자체 지원금은 지역마다 대상·금액·일정이 다릅니다. 내 지역 확인 절차는
        <a href="/issues/chuseok-livelihood-recovery-region-check/">지역별 지원금 확인 방법</a>에서,
        전국 단위 지급 여부는 <a href="/issues/minsaeng-4th-round-payment-status/">4차 민생지원금 지급 여부</a>에서
        정리했습니다.
      </p>
    </section>
  </Container>
</BaseLayout>

<style>
  .region-hero {
    padding: 40px 0 8px;
  }
  .back-link {
    font-size: 13px;
    color: var(--text-2);
    text-decoration: none;
  }
  .title {
    font-size: 28px;
    margin: 12px 0 8px;
  }
  .lead {
    color: var(--text-2);
    line-height: 1.6;
    max-width: 640px;
  }
  .region-section {
    margin: 28px 0;
  }
  .region-section h2 {
    font-size: 19px;
    margin-bottom: 12px;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list li a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 10px 4px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }
  .post-list li a:hover .post-title {
    text-decoration: underline;
  }
  .post-date {
    flex: none;
    font-size: 12px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .post-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }
  .subsidy-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .subsidy-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    text-decoration: none;
    color: var(--text);
  }
  .subsidy-card:hover {
    border-color: var(--accent);
  }
  .subsidy-cat {
    font-size: 12px;
    color: var(--accent);
    font-weight: 700;
  }
  .subsidy-title {
    font-size: 15px;
    line-height: 1.4;
  }
  .subsidy-agency {
    font-size: 12px;
    color: var(--text-2);
  }
  .region-guide {
    line-height: 1.7;
    color: var(--text);
  }
</style>
