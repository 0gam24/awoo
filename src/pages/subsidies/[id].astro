---
import BlufBox from '@/components/BlufBox.astro';
import Container from '@/components/Container.astro';
import Icon from '@/components/Icon.astro';
import MainBackrefBox from '@/components/MainBackrefBox.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatMedianWon, formatWon, MEDIAN_INCOME } from '@/data/site-data';
import { amountDisplay, amountPhrase, amountText, docSourceOf, localAreaOf, withJosa } from '@/lib/subsidy-display';
import { isNew, isStale, getRegDateISO, getLastVerifiedISO, getLastVerifiedKR, STALE_THRESHOLD_DAYS } from '@/lib/subsidies-meta';
import { type GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const subsidies = await getCollection('subsidies');
  return subsidies.map((s) => ({ params: { id: s.data.id }, props: { subsidy: s } }));
}) satisfies GetStaticPaths;

const { subsidy } = Astro.props;
const s = subsidy.data;

const personas = await getCollection('personas');
const matchedPersonas = s.targetPersonas
  .map((pid) => personas.find((p) => p.data.id === pid)?.data)
  .filter(Boolean);

const allSubsidies = await getCollection('subsidies');
const related = allSubsidies
  .filter((x) => x.data.category === s.category && x.data.id !== s.id)
  .slice(0, 3);

// "이 지원금 받는 사람들이 또 받는 것" — 같은 페르소나 교집합 + 다른 카테고리 우선
// (페르소나 매칭은 강한 신호, 카테고리는 너무 좁아서 다양성 확보 필요)
function personaOverlap(otherPersonas: string[]): number {
  if (!otherPersonas?.length || !s.targetPersonas.length) return 0;
  let n = 0;
  for (const p of otherPersonas) if (s.targetPersonas.includes(p)) n++;
  return n;
}

const alsoSeen = allSubsidies
  .filter((x) => {
    if (x.data.id === s.id) return false;
    if (x.data.category === s.category) return false; // related 와 중복 방지
    return personaOverlap(x.data.targetPersonas ?? []) > 0;
  })
  .map((x) => ({
    item: x,
    score:
      personaOverlap(x.data.targetPersonas ?? []) * 10 +
      (x.data.isHot ? 3 : 0) +
      (x.data.status === '신청 가능' ? 2 : 0),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((x) => x.item);

const regDateISO = getRegDateISO(s.id);
const isNewItem = isNew(s.id);
const isStaleItem = isStale(s.id);
const lastVerifiedKR = getLastVerifiedKR(s.id);
const lastVerifiedISO = getLastVerifiedISO(s.id);

// 2026-10-14: 분야 공통 토픽의 FAQ·거절 사유를 끌어오던 블록을 걷어냈다.
// 옹암체육센터 감면 페이지에 학자금대출 FAQ가, 난임 약제비 페이지에 부모급여 FAQ가 뜨고
// 그 엉뚱한 문답이 FAQPage 구조화 데이터로까지 나가고 있었다. 사업마다 다른 문답 자료가 생기기 전까지는 비워 둔다.

// 금액 칸이 0인 사업(감면·실비·서비스)은 "0원" 대신 혜택 종류로 부른다
const amount = amountDisplay(s);
const amountLine = amountText(s);
const area = localAreaOf(s.agency);

// 소득 기준선 — 지원 대상·혜택 문구에 '중위소득 N%'나 수급자·차상위가 나오면 2026년 금액표를 붙인다
const incomeText = [s.summary, ...s.eligibility, ...s.benefits].join(' ');
const incomePcts = [...new Set([...incomeText.matchAll(/중위\s*소득\s*(\d{2,3})\s*%/g)].map((m) => Number(m[1])))]
  .filter((n) => n >= 20 && n <= 300)
  .sort((a, b) => a - b)
  .slice(0, 3);
const incomeCols = incomePcts.length > 0
  ? incomePcts.map((pct) => ({ pct, label: `${pct}%` }))
  : /수급자|차상위/.test(incomeText)
    ? [
        { pct: 32, label: '생계급여 32%' },
        { pct: 50, label: '차상위 50%' },
      ]
    : [];
const incomeLead = incomePcts.length > 0
  ? `이 사업 문구에 나온 기준 중위소득 ${incomePcts.map((p) => `${p}%`).join('·')}를 2026년 금액으로 옮겼어요.`
  : '수급자·차상위 여부를 따지는 사업이라 2026년 생계급여(중위 32%)와 차상위(중위 50%) 선을 함께 보여 드려요.';

// BLUF 자동 통계 (Cycle #3 P0-4) — schema와 본문 인용 단위 동시 확보
const personaLabels = matchedPersonas
  .map((p) => p?.label)
  .filter((x): x is string => Boolean(x));
const personaSummary = personaLabels.length > 0
  ? `${personaLabels.slice(0, 2).join('·')}${personaLabels.length > 2 ? ' 외' : ''}`
  : '대상 확인 필요';
const isClosed = s.status === '마감';
const blufSummarySubsidy = `${s.title} 지원 규모는 ${withJosa(amountPhrase(s), '이고/고')}, ${
  personaLabels.length > 0 ? `${withJosa(personaSummary, '이/가')} 받을 수 있습니다.` : '지원 대상은 아래 조건으로 확인하세요.'
} 신청 기한은 ${s.deadline.trim()}입니다.${s.closedNote ? ` 다만 ${s.closedNote}` : ''}`;
const blufStatsSubsidy = [
  { value: amount.value, label: amount.isMoney ? s.amountLabel || '지원 금액' : amount.unit || '혜택' },
  { value: s.deadline, label: '신청 마감' },
  { value: personaSummary, label: '매칭 페르소나' },
  { value: s.status, label: '신청 상태' },
];

const govSchema = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  '@id': `https://awoo.or.kr/subsidies/${s.id}/#govservice`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://awoo.or.kr/subsidies/${s.id}/`,
  },
  name: s.title,
  serviceType: s.category,
  provider: {
    '@type': 'GovernmentOrganization',
    name: s.agency,
  },
  audience: {
    '@type': 'PeopleAudience',
    audienceType: matchedPersonas.map((p) => p?.label).filter(Boolean).join(', '),
  },
  description: s.summary,
  url: s.applyUrl,
  termsOfService: s.eligibility.join(' / '),
  // 1차 자료 — 정부 공식 신청처 URL을 schema 차원에서 명시 (GEO/AI 인용 핵심 신호)
  isBasedOn: s.applyUrl,
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: s.applyUrl,
    availableLanguage: 'ko',
  },
  // 사이트와이드 Organization을 publisher로 참조 (Cycle #1 P0-2 자산)
  publisher: { '@id': 'https://awoo.or.kr/#organization' },
  ...(regDateISO ? { dateCreated: regDateISO } : {}),
  // 최신성 신호 — Cycle #4 P0-2 (E-E-A-T freshness)
  ...(lastVerifiedISO ? { dateModified: lastVerifiedISO } : {}),
  // 지자체 사업은 그 지역, 중앙부처 사업은 대한민국 (2026-10-14)
  areaServed: area
    ? { '@type': 'AdministrativeArea', name: area }
    : { '@type': 'Country', name: '대한민국', identifier: 'KR' },
  // Cycle #28: potentialAction — 검색 결과 'Apply/신청' 버튼 자격 + AI 답변 엔진 actionable
  // 신청이 끝난 사업에는 '신청하기' 행동을 달지 않는다 (2026-10-14)
  ...(isClosed
    ? {}
    : {
        potentialAction: {
          '@type': 'ApplyAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: s.applyUrl,
            actionPlatform: ['https://schema.org/DesktopWebPlatform', 'https://schema.org/MobileWebPlatform'],
          },
          name: `${s.title} 신청하기`,
        },
      }),
  // 2026-10-14: Offer(price=지원 금액)는 뺐다 — Offer.price는 '이용자가 내는 값'이라 지원액·대출 한도를 넣으면 뜻이 뒤집힌다
};

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '지원금', href: '/subsidies/' },
  { name: s.category, href: `/categories/${encodeURIComponent(s.category)}/` },
  { name: s.title, href: `/subsidies/${s.id}/` },
];

// meta description — gov24 원본 summary가 한 줄(20자 안팎)로 짧은 항목이 많아
// 금액·대상·기관 팩트를 이어붙여 검색 스니펫 정보량을 확보한다 (150자 안에서 순차 누적)
const descParts = [s.summary.trim().replace(/\.$/, '') + '.'];
// 요약 문장에 같은 금액이 이미 있으면("월 최대 20만원 임차료 지원") 되풀이하지 않는다
const summaryHasAmount = s.amount > 0 && Boolean(descParts[0]?.includes(formatWon(s.amount)));
if (s.amount > 0 && !summaryHasAmount)
  descParts.push(`${(s.amountLabel ?? '지원 금액').trim()} ${formatWon(s.amount)}.`);
else if (s.monthly) descParts.push(`${s.monthly.trim()}.`);
else if (!summaryHasAmount) descParts.push(`혜택: ${amountLine}.`);
const firstEligibility = (s.eligibility?.[0] ?? '').trim();
if (firstEligibility) {
  descParts.push(`대상: ${firstEligibility.length > 45 ? `${firstEligibility.slice(0, 44)}…` : firstEligibility}.`);
}
descParts.push(`${s.agency} 신청 자격·방법·기간 정리.`);
let metaDescription = descParts[0] ?? '';
for (const part of descParts.slice(1)) {
  if (`${metaDescription} ${part}`.length > 150) break;
  metaDescription = `${metaDescription} ${part}`;
}
---

<BaseLayout
  title={s.title.includes(s.agency) ? `${s.title} | 지원금가이드` : `${s.title} — ${s.agency} | 지원금가이드`}
  description={metaDescription}
  ogImage={`/og/subsidies/${s.id}.png`}
  activeNav="/subsidies/"
  breadcrumbs={breadcrumbs}
>
  <section class="detail-hero">
    <Container size="wide">
      <a class="back-link" href="/subsidies/">← 둘러보기로</a>
      <div class="hero-grid">
        <div>
          <div class="agency">{s.agency} · {s.category}{isNewItem && <span class="new-pill"><span class="new-dot" aria-hidden="true" />NEW</span>}</div>
          <h1 class="title">{s.title}</h1>
          <div class="amount-row">
            <span class="amount">{amount.value}</span>
            {amount.unit && <span class="unit">{amount.unit}</span>}
          </div>
          {s.monthly && <div class="monthly">{s.monthly}</div>}
          <p class="summary">{s.summary}</p>
          {s.closedNote && (
            <p class="closed-note" role="note">
              <strong>신청 종료</strong> {s.closedNote}
            </p>
          )}
          <div class="tags">
            {s.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        </div>

        <aside class="apply-rail">
          <div class="rail-row">
            <span>적용 대상</span>
          </div>
          <div class="persona-mini-row">
            {
              matchedPersonas.slice(0, 4).map((p) =>
                p ? (
                  <span class="persona-mini">
                    <Icon name={p.icon} size={13} strokeWidth={1.8} />
                    {p.label}
                  </span>
                ) : null,
              )
            }
          </div>
          <div class="rail-row dl-row">
            <span>마감</span>
            <strong>{s.deadline}</strong>
          </div>
          <div class="rail-row dl-row">
            <span>상태</span>
            <strong class={s.status === '신청 가능' ? 'st-ok' : 'st-warn'}>{s.status}</strong>
          </div>
          <a class="btn-primary" href={s.applyUrl} target="_blank" rel="noopener noreferrer">
            {isClosed ? '공식 안내 보기' : '공식 신청처로 이동'}
            <Icon name="arrow-up-right" size={16} />
          </a>
          {alsoSeen.length > 0 && (
            <a class="rail-compare-link" href="#also-seen">
              ↓ 같은 페르소나의 다른 {alsoSeen.length}건 비교
            </a>
          )}
          <p class="disclaimer">
            지원금가이드는 정보 안내 사이트로, 신청 대행은 하지 않습니다.
            실제 신청은 정부24·복지로 등 공식 사이트에서 진행됩니다.
          </p>
          {(lastVerifiedKR || isStaleItem) && (
            <p class={`verified-info ${isStaleItem ? 'stale' : ''}`}>
              {isStaleItem && <span class="verified-warn" aria-hidden="true">⚠</span>}
              마지막 동기화: {lastVerifiedISO ? (
                <time datetime={lastVerifiedISO}><strong>{lastVerifiedKR ?? '확인 필요'}</strong></time>
              ) : (
                <strong>{lastVerifiedKR ?? '확인 필요'}</strong>
              )}
              {isStaleItem && (
                <span class="verified-stale-msg">
                  · {STALE_THRESHOLD_DAYS}일 이상 미검증 — 공식 사이트 최신 정보 확인 권장
                </span>
              )}
            </p>
          )}
        </aside>
      </div>
    </Container>
  </section>

  <section class="band alt">
    <Container size="wide">
      <BlufBox summary={blufSummarySubsidy} stats={blufStatsSubsidy} basis={lastVerifiedKR ? `마지막 동기화: ${lastVerifiedKR}` : '보조금24 + 큐레이션'} />

      {s.fitNotes && Object.keys(s.fitNotes).length > 0 && (
        <div class="fit-notes">
          <div class="fn-head">
            <h2 class="utility">당신과 비슷한 사람의 신청 팁</h2>
            <p class="fn-lead">실제 신청자 후기와 정부 부처 안내를 토대로, 페르소나별 핵심 포인트만 정리했습니다.</p>
          </div>
          <ul class="fn-list">
            {Object.entries(s.fitNotes).map(([pid, note]) => {
              const p = personas.find((x) => x.data.id === pid)?.data;
              if (!p) return null;
              return (
                <li class="fn-card">
                  <a class="fn-link" href={`/personas/${p.id}/`} aria-label={`${p.label} 페르소나 보기`}>
                    <span class="fn-icon" aria-hidden="true">
                      <Icon name={p.icon} size={18} strokeWidth={1.8} />
                    </span>
                    <div class="fn-meta">
                      <div class="fn-label">{p.label}</div>
                      <div class="fn-sub">{p.sub}</div>
                    </div>
                    <span class="fn-arrow" aria-hidden="true">→</span>
                  </a>
                  <p class="fn-note">{note}</p>
                </li>
              );
            })}
          </ul>
        </div>
      )}

      {personaLabels.length > 0 && (
        <h2 class="cat-headline">{withJosa(personaLabels[0] ?? '', '이/가')} 자주 받는 {s.category} 지원금</h2>
      )}

      <div class="two-col">
        <div>
          <h2 class="utility">지원 대상</h2>
          <p class="pc-hint">내게 해당하는 줄에 체크해 보세요. 신청 가능 여부를 판정하지는 않고, 최종 판단은 {s.agency}에서 합니다.</p>
          <ul class="checklist precheck" data-precheck>
            {area && (
              <li>
                <label class="pc-row">
                  <input type="checkbox" class="pc-box" />
                  <span>주관 기관이 {area} 소속이에요. 거주지·사업장 위치 조건이 있는지 공고에서 확인했어요.</span>
                </label>
              </li>
            )}
            {
              s.eligibility.map((e) => (
                <li>
                  <label class="pc-row">
                    <input type="checkbox" class="pc-box" />
                    <span>{e}</span>
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="pc-count" aria-live="polite">
            체크한 항목 <strong data-precheck-n>0</strong> / {s.eligibility.length + (area ? 1 : 0)} · 마감 {s.deadline}
          </p>
        </div>
        <div>
          <h2 class="utility">혜택 내용</h2>
          <ul class="checklist">
            {
              s.benefits.map((b) => (
                <li>
                  <span class="check check-success"><Icon name="check" size={14} strokeWidth={2.4} /></span>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {incomeCols.length > 0 && (
        <div class="income-box">
          <h2 class="utility">소득 기준을 금액으로 보면</h2>
          <p class="income-lead">
            {incomeLead} 소득인정액을 어떻게 셈하는지는 사업마다 다르니 공고를 함께 보세요.
          </p>
          <div class="income-scroll">
            <table class="income-table">
              <caption class="sr-only">2026년 기준 중위소득과 소득 기준선 (월, 원)</caption>
              <thead>
                <tr>
                  <th scope="col">가구원 수</th>
                  <th scope="col">기준 중위소득</th>
                  {incomeCols.map((c) => <th scope="col">{c.label}</th>)}
                </tr>
              </thead>
              <tbody>
                {[1, 2, 3, 4, 5, 6].map((n) => (
                  <tr>
                    <th scope="row">{n}인</th>
                    <td>{formatMedianWon(MEDIAN_INCOME[n] ?? 0)}</td>
                    {incomeCols.map((c) => <td>{formatMedianWon(MEDIAN_INCOME[n] ?? 0, c.pct)}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="income-src">
            출처: <a href="https://www.mohw.go.kr/board.es?mid=a10503000000&bid=0027&act=view&list_no=1487098" target="_blank" rel="noopener noreferrer">보건복지부 2026년도 기준 중위소득 고시</a>. 우리 집이 몇 %인지는 <a href="/calculators/median-income/">중위소득 계산기</a>에서 볼 수 있어요.
          </p>
        </div>
      )}
    </Container>
  </section>

  <section class="band">
    <Container size="wide">
      <div class="two-col">
        <div>
          <h2 class="utility">신청 방법 & 일정</h2>
          <dl class="kv-grid">
            <dt>주관 기관</dt><dd>{s.agency}</dd>
            <dt>지원 기간</dt><dd>{s.period}</dd>
            <dt>마감일</dt><dd>{s.deadline}</dd>
            <dt>신청처</dt><dd><a href={s.applyUrl} target="_blank" rel="noopener noreferrer">공식 신청 안내</a></dd>
          </dl>
        </div>
        <div>
          <h2 class="utility">필요 서류</h2>
          {s.documents.length > 0 ? (
            <ul class="doc-list">
              {
                s.documents.map((d) => (
                  <li>
                    <Icon name="doc" size={18} />
                    <span>{d}</span>
                    {docSourceOf(d) && <span class="doc-src">{docSourceOf(d)}</span>}
                  </li>
                ))
              }
            </ul>
          ) : (
            <p class="doc-empty">
              제출 서류는 공고마다 달라 이 페이지에 따로 적지 않았어요. <a href={s.applyUrl} target="_blank" rel="noopener noreferrer">공식 신청 안내</a>의 공고문에서 확인하세요.
            </p>
          )}
        </div>
      </div>
    </Container>
  </section>

  {
    related.length > 0 && (
      <section class="band alt">
        <Container size="wide">
          <h2 class="display">비슷한 지원금</h2>
          <ul class="related-grid">
            {related.map((r) => (
              <li>
                <a class="related-card" href={`/subsidies/${r.data.id}/`}>
                  <Icon name={r.data.icon} size={28} strokeWidth={1.6} />
                  <div>
                    <div class="r-agency">{r.data.agency}</div>
                    <div class="r-title">{r.data.title}</div>
                    <div class="r-amount">{amountText(r.data)}</div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  {
    alsoSeen.length > 0 && (
      <section class="band" id="also-seen">
        <Container size="wide">
          <div class="display-row">
            <h2 class="display">이 지원금 받는 분들이 또 보는 것</h2>
