---
// 중위소득 % 계산기 전용 페이지 — 홈 IncomeChecker 아일랜드 재사용 (2027년 확정 고시 반영)
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/calculators.css';
import { IncomeChecker } from '@/components/home/IncomeChecker';
import { formatMedianWon, MEDIAN_INCOME_2027 } from '@/data/site-data';

const description =
  '2027년 확정 기준중위소득(+6.70% 인상, 1인 273만·4인 692만원)과 2026년 기준을 비교해 우리 집이 중위소득 몇 %인지, 생계·의료·주거·교육급여 대상인지 10초 만에 계산합니다.';

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '계산기', href: '/calculators/' },
  { name: '중위소득 계산기', href: '/calculators/median-income/' },
];

const HOUSEHOLD_ROWS = [1, 2, 3, 4, 5, 6].map((n) => {
  const m = MEDIAN_INCOME_2027[n] ?? 273.6042;
  return {
    size: `${n}인 가구`,
    p100: formatMedianWon(m, 100),
    p32: formatMedianWon(m, 32),
    p40: formatMedianWon(m, 40),
    p48: formatMedianWon(m, 48),
    p50: formatMedianWon(m, 50),
  };
});

const faq = [
  {
    q: '2027년 기준 중위소득은 얼마나 올랐나요?',
    a: '보건복지부 고시(제2026-157호)에 따라 2027년 기준 중위소득은 전년 대비 6.70% 인상되어 역대 최대 폭을 기록했습니다. 1인 가구는 월 2,736,042원(+171,804원), 4인 가구는 월 6,929,885원(+435,147원)이며 2027년 1월 1일부터 적용됩니다.',
  },
  {
    q: '2027년 생계·의료·주거·교육급여 기준선은 얼마인가요?',
    a: '1인 가구 기준 생계급여(32%) 월 87만 5,533원, 의료급여(40%) 월 109만 4,417원, 주거급여(48%) 월 131만 3,300원, 교육급여(50%) 월 136만 8,021원 이하입니다. 4인 가구는 생계급여 월 221만 7,563원, 주거급여 월 332만 6,345원 이하입니다.',
  },
  {
    q: '세전 소득과 세후 소득 중 무엇을 입력하나요?',
    a: '복지 자격 판정에 쓰이는 소득인정액은 세전 소득에 재산의 소득환산액을 더해 계산합니다. 이 계산기는 세전 월소득 기준의 간이 확인용이므로, 정확한 자격은 복지로(bokjiro.go.kr) 모의계산이나 주민센터 상담으로 확정하세요.',
  },
  {
    q: '기준 중위소득이 오르면 나에게 어떤 혜택이 생기나요?',
    a: '기준선이 6.70% 올라가면서 같은 월급을 받아도 중위소득 비율(%)이 낮아집니다. 지난해에 소득이 살짝 넘어 탈락했던 기초생활보장·청년월세·에너지바우처·국가장학금 등에 새로 포함될 가능성이 커집니다.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://awoo.or.kr/calculators/median-income/#faq',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://awoo.or.kr/calculators/median-income/#app',
  name: '2027 기준중위소득 % 계산기 (2026·2027 비교)',
  url: 'https://awoo.or.kr/calculators/median-income/',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'KRW' },
  publisher: { '@id': 'https://awoo.or.kr/#organization' },
};
---

<BaseLayout
  title="2027 기준중위소득 계산기, 우리 집은 중위소득 몇 %일까 | 지원금가이드"
  description={description}
  activeNav="/calculators/"
  breadcrumbs={breadcrumbs}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <section class="calc-hero income-checker">
    <Container size="wide">
      <h1 class="title">2027 기준중위소득 % 계산기 (2026·2027 비교)</h1>
      <p class="lead">
        가구원 수와 세전 월소득을 입력하면 2027년 확정 기준중위소득(+6.70% 인상)과 2026년 기준 대비
        몇 %인지, 생계·주거·청년·교육 지원 자격선 안에 드는지 바로 보여드립니다.
      </p>
      <IncomeChecker client:visible />
    </Container>
  </section>

  <Container size="wide">
    <section class="calc-section">
      <h2>2027년 가구별 기준중위소득 및 4대 급여 선정기준 (보건복지부 고시 제2026-157호)</h2>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">2027년 1~6인 가구 기준중위소득 및 생계·의료·주거·교육급여 선정기준</caption>
          <thead>
            <tr>
              <th scope="col">구분</th>
              <th scope="col">중위소득 100%</th>
              <th scope="col">생계급여 (32%)</th>
              <th scope="col">의료급여 (40%)</th>
              <th scope="col">주거급여 (48%)</th>
              <th scope="col">교육급여 (50%)</th>
            </tr>
          </thead>
          <tbody>
            {HOUSEHOLD_ROWS.map((r) => (
              <tr>
                <td><strong>{r.size}</strong></td>
                <td>{r.p100}</td>
                <td>{r.p32}</td>
                <td>{r.p40}</td>
                <td>{r.p48}</td>
                <td>{r.p50}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="calc-section">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => (
        <details class="calc-faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
      <p class="calc-note">
        용어가 낯설다면 <a href="/glossary/median-income/">기준 중위소득 용어 정리</a>를,
        생계급여 상세 변화는
        <a href="/issues/median-income-2027-livelihood-benefit-threshold/">2027년 중위소득과 생계급여 기준</a>에서
        확인하세요. 받을 수 있는 지원금 매칭은 <a href="/quick/">5분 진단</a>이 빠릅니다.
      </p>
    </section>
  </Container>
</BaseLayout>
