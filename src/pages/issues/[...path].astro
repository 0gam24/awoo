---
import Container from '@/components/Container.astro';
import Icon from '@/components/Icon.astro';
import MainBackrefBox from '@/components/MainBackrefBox.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatWon } from '@/data/site-data';
import { buildImageObject } from '@/lib/schema';
import { paragraphsAndLists } from '@/lib/inline-markdown';
import { issuePathParam, issueUrlPath } from '@/lib/issue-url.mjs';
import { issueGateReason } from '@/lib/issue-gate.mjs';
import { type GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

interface Source {
  title: string;
  url: string;
  publisher: string;
  pubDate?: string;
}
interface FaqItem {
  q: string;
  a: string;
}
interface Section {
  heading: string;
  lead: string;
  body: string;
}
interface PostTable {
  title: string;
  headers: string[];
  rows: string[][];
}
/** v2: 용어 한 줄 정의 — 화면 용어 박스(<dfn>) + DefinedTermSet JSON-LD */
interface Definition {
  term: string;
  definition: string;
  glossarySlug?: string;
}
/** v2: 갱신 이력 — 가시 업데이트 로그 + dateModified freshness 신호 */
interface UpdateEntry {
  date: string;
  note: string;
}
interface PostData {
  title: string;
  slug: string;
  metaDescription: string;
  /** v2 AEO: 한 줄 정답(≤120자 권장, 수치 포함) — 없으면 tldr[0] 폴백 */
  answer?: string;
  tldr: string[];
  category: string;
  tags: string[];
  coreFacts: { who: string; amount: string; deadline: string; where: string };
  freshness?: { trendingTerm: string; daysActive: number; totalCount: number; rankToday: number };
  sections: Section[];
  table?: PostTable;
  faq: FaqItem[];
  definitions?: Definition[];
  updates?: UpdateEntry[];
  relatedSubsidies: string[];
  relatedPersonas: string[];
  sources: Source[];
  publishedAt: string;
  date: string;
}

export const getStaticPaths = (() => {
  // 빌드타임 — Vite glob (getStaticPaths 호이스팅 호환 위해 함수 내부 정의)
  const issueModules = import.meta.glob<{ default: PostData }>(
    '/src/data/issues/*/*.json',
    { eager: true },
  );
  // Cycle #25: prev/next 자동 계산 — 모든 포스트 시간 desc 정렬 후 인덱스 기반 매핑
  type Entry = { date: string; slug: string; data: PostData };
  const all: Entry[] = [];
  for (const [path, mod] of Object.entries(issueModules)) {
    const m = path.match(/\/issues\/(\d{4}-\d{2}-\d{2})\/([^/]+)\.json$/);
    if (!m) continue;
    const date = m[1];
    const slug = m[2];
    if (!date || !slug || slug.startsWith('_')) continue;
    // Cycle #65 + SEO 감사 W5: 발행 게이트 공유 판정 — 목록·뉴스 sitemap과 동일 기준
    const data = mod.default;
    const gateReason = issueGateReason(date, slug, data);
    if (gateReason) {
      console.warn(`[issues] path 생성 skip: ${date}/${slug} — ${gateReason}`);
      continue;
    }
    all.push({ date, slug, data });
  }
  // 시간 desc 정렬 (최신순)
  all.sort((a, b) =>
    a.date < b.date ? 1 : a.date > b.date ? -1 : a.slug.localeCompare(b.slug),
  );

  return all.map((entry, i) => {
    const prev = all[i + 1]; // desc 정렬: 다음 인덱스는 더 옛날 (prev = older)
    const next = all[i - 1]; // 이전 인덱스는 더 최근 (next = newer)
    return {
      // catch-all [...path]: 구 URL은 'YYYY-MM-DD/slug', 신 URL(2026-07-10+)은 'slug'(날짜 제거)
      params: { path: issuePathParam(entry.date, entry.slug) },
      props: {
        post: entry.data,
        date: entry.date,
        slug: entry.slug,
        prevPost: prev
          ? { date: prev.date, slug: prev.slug, title: prev.data.title }
          : null,
        nextPost: next
          ? { date: next.date, slug: next.slug, title: next.data.title }
          : null,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post, date, slug, prevPost, nextPost } = Astro.props as {
  post: PostData;
  date: string;
  slug: string;
  prevPost: { date: string; slug: string; title: string } | null;
  nextPost: { date: string; slug: string; title: string } | null;
};

const subsidies = await getCollection('subsidies');
const subsidyById = new Map(subsidies.map((s) => [s.data.id, s.data]));
const relatedSubsidies = post.relatedSubsidies
  .map((id) => subsidyById.get(id))
  .filter((x): x is NonNullable<ReturnType<typeof subsidyById.get>> => x !== undefined);

const personas = await getCollection('personas');
const personaById = new Map(personas.map((p) => [p.data.id, p.data]));
const relatedPersonas = post.relatedPersonas
  .map((id) => personaById.get(id))
  .filter((x): x is NonNullable<ReturnType<typeof personaById.get>> => x !== undefined);

// Cycle #31: history.byTerm — dateModified를 트렌딩 lastSeen으로 갱신 (freshness 신호)
interface HistoryEntry { firstSeen: string; lastSeen: string; totalCount: number; daysActive: number }
const histModules = import.meta.glob<{ default: { byTerm?: Record<string, HistoryEntry> } }>(
  '/src/data/issues/_history.json',
  { eager: true },
);
const historyByTerm = Object.values(histModules)[0]?.default?.byTerm ?? {};

// P2: dateModified·OG·hero 수정일을 단일 변수로 통일 (트렌딩 재등장 lastSeen 우선)
const lastSeenForTrend =
  post.freshness?.trendingTerm && historyByTerm[post.freshness.trendingTerm]?.lastSeen
    ? historyByTerm[post.freshness.trendingTerm]!.lastSeen
    : null;
// v2: updates[] 수동 갱신 이력 — 최신 갱신일도 dateModified 후보 (트렌딩 lastSeen과 max 취함)
const updates = post.updates ?? [];
const latestUpdateDate = updates.length > 0 ? [...updates].map((u) => u.date).sort().at(-1) ?? null : null;
// 발행일보다 과거인 후보는 버린다 — 트렌딩 term의 lastSeen이 글보다 오래된 경우
// dateModified가 datePublished보다 과거로 emit돼 '오래된 글'로 보이는 SEO 역전 방지.
const modifiedCandidates = [lastSeenForTrend, latestUpdateDate].filter(
  (d): d is string => Boolean(d) && (d as string) > post.date,
);
const modifiedDate = modifiedCandidates.length > 0 ? modifiedCandidates.sort().at(-1)! : null;
const lastSeenIso = modifiedDate ? `${modifiedDate}T00:00:00.000Z` : post.publishedAt;
const isUpdated = modifiedDate != null && modifiedDate > post.date;

// 토픽 hub는 한국어 키워드 + totalCount≥1 일 때만 빌드됨([term].astro 가드와 동일).
// 미빌드 term에는 pill을 링크하지 않는다 — 죽은 hub 링크(dangling) 차단.
const trendTerm = post.freshness?.trendingTerm;
const topicHubExists = Boolean(
  trendTerm && /[가-힣]/.test(trendTerm) && (historyByTerm[trendTerm]?.totalCount ?? 0) >= 1,
);

// 독자용 공식 안내·신청 외부 링크 — sources 중 정부 도메인 우선 (applyUrl은 JSON-LD에만 있어 화면에 노출)
const officialSource = (post.sources ?? []).find((s) => /\.go\.kr|\.gov\.kr|bokjiro/.test(s.url ?? '')) ?? null;

// v2 AEO: 한 줄 정답 — post.answer 우선, 없으면 tldr[0] 폴백.
// 폴백 시 tldr 리스트에서 첫 항목을 빼서 화면 중복을 없앤다 (기존 포스트도 자동으로 정답 박스 획득).
const answerText = (post.answer ?? post.tldr?.[0] ?? '').trim() || null;
const usesTldrAsAnswer = !post.answer?.trim() && Boolean(post.tldr?.[0]);
const tldrList = usesTldrAsAnswer ? (post.tldr ?? []).slice(1) : (post.tldr ?? []);

// v2: 용어 정의 — 화면 박스 + DefinedTermSet JSON-LD
const definitions = post.definitions ?? [];

// 코어팩트 값에서 핵심 숫자/금액/날짜를 시각 강조(.cf-num) — 데이터 구조 변경 없이 긴 문장 속 '25만원'이 묻히지 않게
function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
const CF_NUM_RE = /(?:최대\s*)?\d[\d,]*\s*(?:억\s*)?만?\s*원|\d{4}[.\-]\d{1,2}[.\-]\d{1,2}|~\s*\d{1,2}[.\-]\d{1,2}|\d{1,2}\s*월\s*\d{1,2}\s*일|\d[\d,]*\s*%|\d[\d,]*\s*(?:일|개월|년|건|명|곳)/;
function highlightFact(raw: string | undefined): string {
  const s = escapeHtml(((raw ?? '').toString().trim()) || '확인 필요');
  const m = s.match(CF_NUM_RE);
  if (!m || m.index === undefined) return s;
  return `${s.slice(0, m.index)}<strong class="cf-num">${m[0]}</strong>${s.slice(m.index + m[0].length)}`;
}

// JSON-LD — NewsArticle 강화 (mainEntityOfPage·articleSection·inLanguage 등)
const canonicalUrl = `https://awoo.or.kr${issueUrlPath(date, slug)}`;
// Cycle #88: factCheckScore — articleSchema reviewedBy + ClaimReview emit 조건. 하단 isThinPost 검사에서도 재사용.
const factCheckScore = (post as { factCheckScore?: number }).factCheckScore ?? 1;
// Cycle #11 P0-1: wordCount — AI 인용 confidence 신호 (콘텐츠 depth 명시)
const articleWordCount =
  (post.metaDescription?.length ?? 0) +
  (post.tldr ?? []).reduce((s, t) => s + t.length, 0) +
  (post.sections ?? []).reduce(
    (s, sec) => s + (sec.heading?.length ?? 0) + (sec.lead?.length ?? 0) + (sec.body?.length ?? 0),
    0,
  ) +
  (post.faq ?? []).reduce((s, f) => s + (f.q?.length ?? 0) + (f.a?.length ?? 0), 0);
// Cycle #78: reportType 분기 — 트렌딩(NewsArticle) vs 분석/가이드(Article)
// AI 답변 엔진(Perplexity 등)은 Article을 "evergreen reference"로, NewsArticle을 "speed news"로 분류.
// Source 2-5는 분석·가이드라 Article + isBasedOn(정부 출처)이 더 적합.
const reportType = (post as { reportType?: string }).reportType;
const articleType: 'NewsArticle' | 'Article' = reportType ? 'Article' : 'NewsArticle';
// Article 분기 시 isBasedOn (정부 공식 출처) 명시 — AI 인용 신뢰도 ↑
const isBasedOnList = reportType
  ? (post.sources ?? [])
      .filter((s) => {
        const url = s.url ?? '';
        return /\.gov\.kr|\.go\.kr|bokjiro/.test(url);
      })
      .slice(0, 5)
      .map((s) => ({
        '@type': 'CreativeWork',
        name: s.title,
        url: s.url,
        publisher: s.publisher ? { '@type': 'GovernmentOrganization', name: s.publisher } : undefined,
      }))
  : [];

// v2 GEO: 전체 출처를 citation으로 승격 — isBasedOn(정부 1차 한정)과 별개로
// 언론·기관 출처 전부를 인용 그래프에 노출 (AI 답변 엔진 attribution 소스)
const citationList = (post.sources ?? []).slice(0, 8).map((s) => ({
  '@type': 'CreativeWork',
  name: s.title,
  url: s.url,
  ...(s.publisher
    ? {
        publisher: {
          '@type': /\.gov\.kr|\.go\.kr|bokjiro/.test(s.url ?? '')
            ? 'GovernmentOrganization'
            : 'Organization',
          name: s.publisher,
        },
      }
    : {}),
}));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': articleType,
  '@id': canonicalUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  headline: post.title,
  description: post.metaDescription,
  url: canonicalUrl,
  inLanguage: 'ko-KR',
  datePublished: post.publishedAt,
  // Cycle #31: dateModified — history.lastSeen 우선 (트렌딩 재등장 시 freshness 갱신). P2: 공통 변수.
  dateModified: lastSeenIso,
  articleSection: post.category,
  keywords: post.tags.join(', '),
  // v2: about을 string → Thing entity로 승격 — 토픽 hub 존재 시 url 연결 (entity 그래프)
  about: {
    '@type': 'Thing',
    name: post.freshness?.trendingTerm ?? post.tags[0],
    ...(topicHubExists && trendTerm
      ? { url: `https://awoo.or.kr/issues/topics/${encodeURIComponent(trendTerm)}/` }
      : {}),
  },
  // v2 AEO: abstract = 한 줄 정답 — AI 답변 엔진이 요약 청크로 즉시 발췌
  ...(answerText ? { abstract: answerText } : {}),
  // v2 AEO: speakable을 Article 레벨에도 명시 (spec상 Article/WebPage 소속) — 정답 박스 + TL;DR 청크
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.answer-box', '.tldr li'],
  },
  // 본 사이트는 AI 보조 + 사람 편집 정책 (editorial-policy 페이지 명시)
  // E-E-A-T 강화 — 책임 편집자 실명 명시 (Discover YMYL 영역 가산)
  author: [
    {
      '@type': 'Person',
      name: '김준혁',
      jobTitle: '편집책임자',
      url: 'https://awoo.or.kr/about/',
      worksFor: {
        '@type': 'Organization',
        name: '스마트데이터샵',
      },
    },
    {
      '@type': 'Organization',
      name: '지원금가이드 편집팀',
      url: 'https://awoo.or.kr/editorial-policy/',
    },
  ],
  // 사이트와이드 Organization @id 참조 (Cycle #1 P0-2 자산) — entity 일관성 + 중복 제거
  publisher: { '@id': 'https://awoo.or.kr/#organization' },
  image: [
    buildImageObject({
      url: `https://awoo.or.kr/og/issues/${slug}.png`,
      caption: post.title,
    }),
  ],
  isAccessibleForFree: true,
  // Cycle #11 P0-1: AI 답변 엔진 인용 confidence 신호
  wordCount: articleWordCount,
  // Cycle #29: archive + topic hub 관계 명시 (entity 그래프 strengthen)
  isPartOf: {
    '@type': 'CollectionPage',
    '@id': 'https://awoo.or.kr/issues/all/#collection',
    name: '전체 분석 포스트 아카이브',
    url: 'https://awoo.or.kr/issues/all/',
  },
  ...(topicHubExists && post.freshness?.trendingTerm
    ? {
        discussionUrl: `https://awoo.or.kr/issues/topics/${encodeURIComponent(post.freshness.trendingTerm)}/`,
      }
    : {}),
  // Cycle #6 P0-4: audience + mentions — 페르소나 매칭 + glossary entity 그래프 연결
  // relatedPersonas/relatedSubsidies는 이미 .data 객체 추출됨 (Map.get 결과)
  ...(relatedPersonas.length > 0
    ? {
        audience: {
          '@type': 'PeopleAudience',
          audienceType: relatedPersonas.map((p) => p.label).join(', '),
        },
      }
    : {}),
  ...(relatedSubsidies.length > 0
    ? {
        mentions: relatedSubsidies.map((s) => ({
          '@type': 'GovernmentService',
          '@id': `https://awoo.or.kr/subsidies/${s.id}/#govservice`,
          name: s.title,
        })),
      }
    : {}),
  // Cycle #78: Article 분기 시 정부 공식 출처 명시 (AI 인용 신뢰도 강화)
  ...(isBasedOnList.length > 0 ? { isBasedOn: isBasedOnList } : {}),
  // v2 GEO: 전체 출처 인용 그래프 (언론 포함 최대 8건)
  ...(citationList.length > 0 ? { citation: citationList } : {}),
  // Cycle #88: NewsArticle 한국어 신호 — Naver Yeti·SmartBlock 인식 강화
  // dateline = 발신지, copyrightHolder/Year = entity 그래프 + 저작권 신호
  dateline: '지원금가이드',
  copyrightHolder: { '@id': 'https://awoo.or.kr/#organization' },
  copyrightYear: new Date(post.publishedAt).getUTCFullYear(),
  // Cycle #88 P5: potentialAction (ApplyAction) — Google AI Overviews "do" intent 노출 자격.
  // 첫 매칭 지원금의 신청 URL을 primary action target으로 합성. 페르소나는 audience로 노출.
  // applyUrl 없으면 omit — 의도 일치하지 않는 action 노출 방지.
  ...(relatedSubsidies[0]?.applyUrl
    ? {
        potentialAction: {
          '@type': 'ApplyAction',
          name: `${relatedSubsidies[0].title} 신청하기`,
          target: {
            '@type': 'EntryPoint',
            urlTemplate: relatedSubsidies[0].applyUrl,
            actionPlatform: [
              'https://schema.org/DesktopWebPlatform',
              'https://schema.org/MobileWebPlatform',
            ],
          },
          // 마감 정보가 있으면 텍스트 형태로 안내 (ISO 변환은 코어팩트 문자열 다양성 때문에 생략)
          ...(post.coreFacts?.deadline ? { description: `마감: ${post.coreFacts.deadline}` } : {}),
          ...(relatedPersonas.length > 0
            ? {
                participant: {
                  '@type': 'PeopleAudience',
                  audienceType: relatedPersonas.map((p) => p.label).join(', '),
                },
              }
            : {}),
        },
      }
    : {}),
  // E-E-A-T (Cycle #88): 책임 편집자 검수 명시 — YMYL Discover 가산
  ...(typeof factCheckScore === 'number' && factCheckScore >= 0.7
    ? {
        reviewedBy: {
          '@type': 'Person',
          name: '김준혁',
          jobTitle: '편집책임자',
          url: 'https://awoo.or.kr/about/',
        },
      }
    : {}),
};

// ClaimReview는 emit하지 않는다 — 구글 팩트체크 가이드라인상 리뷰 대상 클레임은
// 제3자 발화여야 하며, 자기 글 요약을 자기 조직이 평점 매기는 구조는 YMYL 사이트에서
// 기만적 구조화 데이터로 판정될 수 있다. 검증 신호는 NewsArticle의 reviewedBy로 유지.

// Cycle #78: HowTo schema 자동 생성 — body에서 "**N단계:**" 패턴 감지 시
// "어떻게 신청하나요?" 등 신청 절차 섹션의 단계를 HowToStep으로 변환.
const stepRegex = /\*\*\s*(\d+)\s*단계\s*[:：]\s*([^*\n]+?)\s*\*\*\s*[—\-:]?\s*([\s\S]*?)(?=\*\*\s*\d+\s*단계|$)/g;
let howToSchema: Record<string, unknown> | null = null;
for (const sec of post.sections ?? []) {
  if (!sec.body) continue;
  // 신청·절차·방법 키워드 있는 섹션만 검사 (false positive 방지)
  const isApplyHeading = /신청|절차|방법|어떻게/.test(sec.heading ?? '');
  if (!isApplyHeading) continue;
  const matches = [...sec.body.matchAll(stepRegex)];
  if (matches.length < 2) continue; // 2단계 이상이어야 HowTo 가치
  howToSchema = {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${canonicalUrl}#howto`,
    name: `${post.title} — ${sec.heading}`,
    inLanguage: 'ko-KR',
    description: sec.lead ?? `${post.title}의 단계별 신청 절차`,
    step: matches.map((m, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: (m[2] ?? `단계 ${i + 1}`).trim(),
      text: (m[3] ?? '').trim().slice(0, 500),
    })),
  };
  break; // 첫 신청 절차 섹션만 HowTo로
}

// v2 AEO/GEO: definitions[] → DefinedTermSet — 용어 정의를 entity로 노출.
// AI 답변 엔진이 사용자 질문의 용어를 본 포스트 정의로 매핑 (glossary hub와 그래프 연결).
const definedTermSchema = definitions.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'DefinedTermSet',
      '@id': `${canonicalUrl}#terms`,
      name: `${post.title} — 핵심 용어`,
      inLanguage: 'ko-KR',
      isPartOf: { '@id': canonicalUrl },
      hasDefinedTerm: definitions.map((d) => ({
        '@type': 'DefinedTerm',
        name: d.term,
        description: d.definition,
        ...(d.glossarySlug ? { url: `https://awoo.or.kr/glossary/${d.glossarySlug}/` } : {}),
      })),
    }
  : null;

// Cycle #26: speakable schema — FAQ를 음성 검색 (Google Assistant, Bixby 등) 친화적으로 마킹
// Cycle #88: cssSelector 확장 — sentence-level chunk(.lead-sentence) + 자기충족 청크(.tldr li) 추가.
// AI 답변 엔진(Perplexity/ChatGPT Search/Claude)이 self-contained 문장을 우선 인용.
const faqSchema = post.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // P2: 그래프 정합 — @id/isPartOf/inLanguage 명시(분리 블록이라 @graph 통합 불필요)
  '@id': `${canonicalUrl}#faq`,
  inLanguage: 'ko-KR',
  isPartOf: { '@id': canonicalUrl },
  mainEntity: post.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
  speakable: {
    '@type': 'SpeakableSpecification',
    // P2: .lead 과다매칭(모든 섹션 리드) 제거 → 자기충족 청크만 음성 발췌
    // v2: 한 줄 정답 박스 추가 — 최우선 음성/발췌 청크
    cssSelector: ['.answer-box', '.tldr', '.tldr li', '.faq-section'],
  },
} : null;

const breadcrumbs = [
  { name: '홈', href: '/' },
  { name: '오늘의 이슈', href: '/issues/' },
  { name: post.title, href: issueUrlPath(date, slug) },
];

// 읽기 시간 — 한국어 분당 평균 500자 기준
function readingTimeMinutes(): number {
  const all =
    (post.tldr ?? []).join(' ') +
    ' ' +
    post.sections.map((s) => `${s.heading} ${s.lead} ${s.body}`).join(' ') +
    ' ' +
    post.faq.map((f) => `${f.q} ${f.a}`).join(' ');
  const chars = all.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 500));
}
const readMin = readingTimeMinutes();

// Cycle #23 P0-3: thin post auto-noindex (AdSense 정책 정합)
// 평가 결과: "확인 필요" 같은 broad claims만 있는 글이 거부 사유. 자동 검사로 차단.
const fullText = [
  post.metaDescription ?? '',
  ...(post.tldr ?? []),
  ...post.sections.map((s) => `${s.heading} ${s.lead} ${s.body}`),
  ...post.faq.map((f) => `${f.q} ${f.a}`),
].join(' ');
const totalChars = fullText.replace(/\s+/g, '').length;
// '확인해'(정상 안내문: "공고를 확인해 두세요")는 제외 — YMYL 프레이밍 규칙이 권장하는 표현이
// noindex 오탐을 일으켰음(2026-07-25 GSC noindex 보고 5건). 진짜 placeholder성 모호 표현만 계수.
const vagueCount = (fullText.match(/(확인\s*필요|문의\s*요망|공식\s*공고\s*참조|추후\s*공지\s*예정|내용\s*미정)/g) ?? []).length;
// factCheckScore는 frontmatter 상단에서 이미 선언됨 (articleSchema reviewedBy + ClaimReview emit에서 우선 사용)
// thin 기준: 본문 1500자 미만 OR vague 표현 5건 이상 OR factCheck < 0.6
const isThinPost = totalChars < 1500 || vagueCount >= 5 || factCheckScore < 0.6;

// Cycle #76: reportType별 배지 — frontmatter에서 미리 계산 (JSX 안 generic <...>가 astro parser 충돌)
const RT_LABELS = {
  'new-subsidies-weekly': '🆕 신규 등록 비교',
  'new-subsidies-detail': '🔍 신규 지원금 심층',
  'deadline-imminent-weekly': '⏰ 마감 임박',
  'weekly-essentials': '🗂 핵심',
  'issue-followup': '🔎 후속',
} as const;
type ReportType = keyof typeof RT_LABELS;
const rt = (post as { reportType?: string }).reportType;
const reportTypeBadge = rt && rt in RT_LABELS
  ? { rt, label: RT_LABELS[rt as ReportType] }
  : null;
---

<BaseLayout
  title={`${post.title} | 지원금가이드`}
  description={post.metaDescription}
  activeNav="/issues/"
  breadcrumbs={breadcrumbs}
  noindex={isThinPost}
  keywords={post.tags?.slice(0, 8)}
  ogImage={`/og/issues/${slug}.png`}
  ogType="article"
  ogArticle={{
    publishedTime: post.publishedAt,
    modifiedTime: lastSeenIso,
    author: '김준혁',
    section: post.category,
    tags: post.tags,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {/* Cycle #78: HowTo schema (단계별 신청 절차) — Google rich result + AI 답변 엔진 인용 */}
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
  {/* v2: DefinedTermSet — 용어 정의 entity (AI 답변 용어 매핑 + glossary 그래프) */}
  {definedTermSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />
  )}

  <script>
    // 공유 — Web Share API 우선, 없으면 clipboard, 모두 실패 시 prompt
    const btn = document.querySelector<HTMLButtonElement>('[data-share-btn]');
    if (btn) {
      const url = btn.dataset.shareUrl ?? window.location.href;
      const title = btn.dataset.shareTitle ?? document.title;
      const original = btn.textContent;
      btn.addEventListener('click', async () => {
        try {
          if (typeof navigator.share === 'function') {
            await navigator.share({ title, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          btn.textContent = '✓ 링크 복사됨';
        } catch {
          window.prompt('복사할 링크', url);
        } finally {
          setTimeout(() => {
            if (btn.textContent !== original) btn.textContent = original;
          }, 2000);
        }
      });
    }
  </script>

  {/* Cycle #44: reading progress bar — 사용자 체류·dwell time ↑ + 시각 피드백 */}
  <div class="reading-progress" aria-hidden="true">
    <div class="rp-bar" data-reading-progress></div>
  </div>
  <script is:inline>
    (() => {
      const bar = document.querySelector('[data-reading-progress]');
      if (!bar) return;
      const article = document.querySelector('article.band');
      if (!article) return;
      function update() {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        if (total <= 0) {
          bar.style.width = '100%';
          return;
        }
        const scrolled = -rect.top;
        const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
        bar.style.width = pct + '%';
      }
      let raf = 0;
      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          update();
          raf = 0;
        });
      }, { passive: true });
      update();
    })();
  </script>

  <article class="band">
    <Container size="wide">
      <a class="back-link" href="/">← 홈으로</a>

      <header class="hero">
        <div class="meta">
          {/* Cycle #76: reportType별 배지 — 트렌딩 vs 신규/마감/페르소나/카테고리 분석 차별화 */}
          {reportTypeBadge && (
            <span class={`report-type-pill rt-${reportTypeBadge.rt}`}>{reportTypeBadge.label}</span>
          )}
          {post.freshness && topicHubExists && (
            <a
              class="freshness-pill"
              href={`/issues/topics/${encodeURIComponent(post.freshness.trendingTerm)}/`}
              title={`${post.freshness.trendingTerm} 토픽 hub로 이동`}
            >
              <span class="dot" aria-hidden="true" />
              {post.freshness.daysActive}일 연속 화제
              {post.freshness.totalCount > 0 && ` · ${post.freshness.totalCount}건 보도`}
            </a>
          )}
          {post.freshness && !topicHubExists && (
            <span class="freshness-pill freshness-pill--static">
              <span class="dot" aria-hidden="true" />
              {post.freshness.daysActive}일 연속 화제
              {post.freshness.totalCount > 0 && ` · ${post.freshness.totalCount}건 보도`}
            </span>
          )}
          <span class="cat-pill">{post.category}</span>
          <span class="date"><time datetime={post.date}>{post.date}</time>{isUpdated && ` · 업데이트 ${modifiedDate}`}</span>
          <span class="read-time" aria-label={`${readMin}분 분량`}>📖 {readMin}분</span>
          <button
            type="button"
            class="share-btn"
            data-share-btn
            data-share-url={`https://awoo.or.kr${issueUrlPath(date, slug)}`}
            data-share-title={post.title}
            aria-live="polite"
          >🔗 공유</button>
        </div>

        <h1 class="title">{post.title}</h1>

        {/* v2 AEO: 한 줄 정답 — H1 직후 직접 답변 청크 (Featured Snippet·AI Overviews·음성 발췌 표적) */}
        {answerText && (
          <div class="answer-box" id="answer">
            <div class="ab-label">한 줄 정답</div>
            <p class="ab-text">{answerText}</p>
          </div>
        )}

        {/* 독자 우선: 핵심 정보를 H1 직후로 — 첫 화면에서 자격/금액/마감/신청 즉답 */}
        <h2 class="sr-only">핵심 정보</h2>
        <div class="core-facts">
          <div class="fact"><div class="lbl">대상</div><div class="val" set:html={highlightFact(post.coreFacts.who)} /></div>
          <div class="fact"><div class="lbl">금액</div><div class="val" set:html={highlightFact(post.coreFacts.amount)} /></div>
          <div class="fact"><div class="lbl">기간</div><div class="val" set:html={highlightFact(post.coreFacts.deadline)} /></div>
          <div class="fact"><div class="lbl">신청</div><div class="val" set:html={highlightFact(post.coreFacts.where)} /></div>
        </div>

        {/* 독자 행동: 화면에서 공식 안내·신청처로 바로 가는 외부 링크 */}
        {officialSource && (
          <a class="official-cta" href={officialSource.url} target="_blank" rel="noopener noreferrer">
            🔗 공식 안내·신청 바로가기{officialSource.publisher ? ` (${officialSource.publisher})` : ''}<span class="sr-only"> (새 창)</span>
          </a>
        )}

        {/* v2: 정답 박스가 tldr[0] 폴백일 땐 리스트에서 첫 항목 제외 (화면 중복 방지) */}
        {tldrList.length > 0 && (
          <div class="tldr">
            <h2 class="sr-only">핵심 요약</h2>
            <div class="tldr-label">핵심 요약</div>
            <ul>
              {tldrList.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}

        {/* 편집·검수 신뢰 단서 — 사람 검수 + 정부 공식 출처를 전면화.
            AI 보조 활용은 편집정책 페이지에 투명 공개(여기선 숫자 점수·AI 라벨 미노출 → YMYL 첫인상 신뢰). */}
        <aside class="ai-disclosure" aria-label="편집·검수 정보">
          <span class="ai-icon" aria-hidden="true">✓</span>
          <span class="ai-text">
            편집책임자 <a href="/editor/jjh/"><strong>김준혁</strong></a> 검수 · 정부 공식 출처 기반
            <a class="ai-policy" href="/editorial-policy/">편집 정책</a>
          </span>
        </aside>

        {/* v2: 갱신 이력 — 무엇이 언제 바뀌었는지 가시화 (freshness 신호 + YMYL 신뢰) */}
        {updates.length > 0 && (
          <aside class="updates-log" aria-label="업데이트 내역">
            <div class="ul-label">업데이트 내역</div>
            <ul>
              {updates.map((u) => (
                <li>
                  <time datetime={u.date}>{u.date}</time> — {u.note}
                </li>
              ))}
            </ul>
          </aside>
        )}

        {/* Cycle #70: sourceConfidence='low' 정보 제한 disclaimer — Top 3 보장 시 단일/소수 매체 보도 명시 */}
        {(post as { sourceConfidence?: string }).sourceConfidence === 'low' && (
          <aside class="source-disclaimer" aria-label="정보 제한 알림">
            <span class="sd-icon" aria-hidden="true">ⓘ</span>
            <span class="sd-text">
              <strong>정보 제한 알림</strong> — 매체
              <strong> {(post as { sourcePublisherCount?: number }).sourcePublisherCount ?? 1}곳</strong>의
              제한된 보도 기반 정리. 정확한 자격·금액·신청 방법은 본문 하단 출처와
              <strong> 정부 공식 사이트</strong>에서 반드시 확인하세요.
            </span>
          </aside>
        )}

        {/* Cycle #45: 자동 ToC — 긴 글 네비 + AI 답변 엔진 page-outline 신호 */}
        {post.sections.length >= 3 && (
          <nav class="toc" aria-label="목차">
            <div class="toc-label">목차</div>
            <ol class="toc-list">
              {post.sections.map((s, i) => (
                <li>
                  <a href={`#sec-${i + 1}`}>
                    <span class="toc-num">{i + 1}.</span>
                    <span class="toc-text">{s.heading}</span>
                  </a>
                </li>
              ))}
              {post.faq.length > 0 && (
                <li>
                  <a href="#faq">
                    <span class="toc-num">★</span>
                    <span class="toc-text">자주 묻는 질문 ({post.faq.length}건)</span>
                  </a>
                </li>
              )}
              {post.sources.length > 0 && (
                <li>
                  <a href="#sources">
                    <span class="toc-num">★</span>
                    <span class="toc-text">원문 출처 ({post.sources.length}건)</span>
                  </a>
                </li>
              )}
            </ol>
          </nav>
        )}
      </header>

      <div class="body-grid">
        <div class="body">
          {/* v2 AEO/GEO: 용어 먼저 정리 — <dfn> 격리 청크 (AGENTS §12-2) + DefinedTermSet 대응 */}
          {definitions.length > 0 && (
            <section class="post-section terms-box" id="terms">
              <h2>용어 먼저 정리</h2>
              <dl class="terms-list">
                {definitions.map((d) => (
                  <div class="term-row">
                    <dt><dfn>{d.term}</dfn></dt>
                    <dd>
                      {d.definition}
                      {d.glossarySlug && (
                        <a class="term-more" href={`/glossary/${d.glossarySlug}/`}>자세히 →</a>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {post.sections.map((s, i) => {
            // Cycle #35: anchor id 자동 생성 — AI 답변 엔진 + 검색 결과 deep-link
            const anchorId = `sec-${i + 1}`;
            return (
            <section class="post-section" id={anchorId}>
              <h2>
                <a class="sec-anchor" href={`#${anchorId}`} aria-label={`${s.heading} 섹션 직접 링크`}>
                  {s.heading}
                </a>
              </h2>
              <p class="lead">{s.lead}</p>
              <div class="prose">
                {paragraphsAndLists(s.body).map((block) =>
                  block.type === 'p' ? (
                    /^<strong>\s*\d+\s*단계/.test(block.html) ? (
                      <p class="step" set:html={block.html} />
                    ) : (
                      <p set:html={block.html} />
                    )
                  ) : (
                    <ul>
                      {block.items.map((item) => <li set:html={item} />)}
                    </ul>
                  ),
                )}
              </div>
            </section>
          );})}

          {post.table && (
            <section class="post-section">
              <h2>{post.table.title}</h2>
              <div class="table-wrap">
                <table>
                  <caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">{post.table.title}</caption>
                  <thead>
                    <tr>{post.table.headers.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {post.table.rows.map((row) => (
                      <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {relatedSubsidies.length > 0 && (
            <section class="post-section">
              <h2>이 이슈와 함께 보면 좋은 지원금</h2>
              <ul class="related-grid">
                {relatedSubsidies.map((s) => (
                  <li>
                    <a class="related-card" href={`/subsidies/${s.id}/`}>
                      <div class={`media tint-${s.category}`}>
                        <Icon name={s.icon} size={22} strokeWidth={1.6} />
                      </div>
                      <div class="rc-body">
                        <div class="rc-cat">{s.category} · {s.agency}</div>
                        <div class="rc-title">{s.title}</div>
                        <div class="rc-amt">
                          {s.amount > 0 ? formatWon(s.amount) : '내용 확인'}
                          {s.amount > 0 && <span class="rc-unit">{s.amountLabel}</span>}
                        </div>
                      </div>
                      <span class="rc-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {relatedPersonas.length > 0 && (
            <section class="post-section">
              <h2>이런 분에게 추천</h2>
              <ul class="persona-row">
                {relatedPersonas.map((p) => (
                  <li>
                    <a class="persona-chip" href={`/personas/${p.id}/`}>
                      <Icon name={p.icon} size={16} strokeWidth={1.7} />
                      <span>{p.label}</span>
                      <span class="rc-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {post.faq.length > 0 && (
            <section class="post-section faq-section" id="faq">
              <h2>
                <a class="sec-anchor" href="#faq">자주 묻는 질문</a>
              </h2>
              <div class="faq">
                {post.faq.map((f, i) => (
                  <details class="faq-item" open={i === 0}>
                    <summary>{f.q}</summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )}

          {post.sources.length > 0 && (
            <section class="post-section sources" id="sources">
              <h2>
                <a class="sec-anchor" href="#sources">원문 출처 {post.sources.length}건</a>
              </h2>
              <p class="sources-lead">
                본 분석은 <strong>{new Set(post.sources.map((s) => s.publisher)).size}곳 매체 {post.sources.length}건</strong>의 보도를 종합했습니다.
                매체별로 보도 각도가 다를 수 있어, 가능한 모든 출처를 명시합니다.
              </p>
              <ul class="sources-grid">
                {post.sources.map((src) => (
                  <li>
                    <a class="source-card" href={src.url} target="_blank" rel="nofollow noopener noreferrer">
                      <div class="src-meta">
                        <span class="src-publisher">{src.publisher}</span>
                        {src.pubDate && <span class="src-date">{(src.pubDate as string).slice(0, 10)}</span>}
                      </div>
                      <div class="src-title">{src.title}</div>
                      <span class="src-cta">원문 보기 →</span>
                      <span class="sr-only"> (새 창에서 열림)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="next-actions">
            <div class="na-eyebrow">다음 단계</div>
            <h2>이 이슈를 보셨다면</h2>
            <ul class="na-grid">
              <li>
                <a class="na-card na-primary" href="/quick/">
                  <div class="na-step">1</div>
                  <div class="na-body">
                    <div class="na-title">5분 진단으로 정확히 매칭</div>
                    <div class="na-desc">페르소나·소득·관심 분야 4단계 — 입력은 익명, 저장 X.</div>
                  </div>
                  <span class="na-arrow" aria-hidden="true">→</span>
                </a>
              </li>
              {relatedSubsidies[0] && (
                <li>
                  <a class="na-card" href={`/subsidies/${relatedSubsidies[0].id}/`}>
                    <div class="na-step">2</div>
                    <div class="na-body">
                      <div class="na-title">관련 지원금 바로 보기</div>
                      <div class="na-desc">{relatedSubsidies[0].title} · {relatedSubsidies[0].agency}</div>
                    </div>
                    <span class="na-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              )}
              {relatedPersonas[0] && (
                <li>
                  <a class="na-card" href={`/personas/${relatedPersonas[0].id}/`}>
