---
import Container from '@/components/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const SITE = 'https://awoo.or.kr';

// 구독 피드 3종(이슈) + 신규 지원금 RSS
const feeds = [
  {
    name: '오늘의 이슈 — RSS',
    href: '/feed-issues.xml',
    desc: '매일 발행하는 정부 지원금 정책 이슈를 RSS 2.0으로 구독합니다. Feedly·이메일 리더 등 대부분의 RSS 앱에서 지원됩니다.',
    badge: 'RSS',
  },
  {
    name: '오늘의 이슈 — Atom',
    href: '/atom.xml',
    desc: '같은 이슈 글을 표준 Atom 1.0 포맷으로 제공합니다. Atom만 지원하는 리더·자동화 도구에 적합합니다.',
    badge: 'Atom',
  },
  {
    name: '오늘의 이슈 — JSON Feed',
    href: '/feed.json',
    desc: 'AI 에이전트·모던 리더가 바로 파싱할 수 있는 JSON Feed 1.1 포맷입니다. 제목·요약·태그·발행일을 구조화해 제공합니다.',
    badge: 'JSON',
  },
  {
    name: '신규 정부 지원금 — RSS',
    href: '/feed.xml',
    desc: '새로 등록된 정부 지원금(자격·금액·신청처)을 별도 채널로 구독합니다. 이슈 글과 분리돼 있어 원하는 채널만 받을 수 있습니다.',
    badge: 'RSS',
  },
];

// 카테고리별 RSS — 이슈를 분야 채널로 분리 구독
const categoryFeeds = [
  { ko: '복지', href: '/rss/welfare.xml' },
  { ko: '자산', href: '/rss/assets.xml' },
  { ko: '교육', href: '/rss/education.xml' },
  { ko: '주거', href: '/rss/housing.xml' },
  { ko: '농업', href: '/rss/agriculture.xml' },
  { ko: '창업', href: '/rss/startup.xml' },
  { ko: '취업', href: '/rss/employment.xml' },
];

// AI·검색 엔진용 파일
const machineFiles = [
  {
    name: 'llms.txt',
    href: '/llms.txt',
    desc: 'AI 언어모델용 사이트 요약 색인. 주요 카테고리와 대표 문서를 한 파일로 안내합니다.',
  },
  {
    name: 'llms-full.txt',
    href: '/llms-full.txt',
    desc: '전체 콘텐츠를 담은 확장 색인. AI가 사이트 전반을 인용·학습하기 쉽도록 제공합니다.',
  },
  {
    name: 'sitemap-index.xml',
    href: '/sitemap-index.xml',
    desc: '검색 엔진용 사이트맵 인덱스. 전체 페이지·뉴스 사이트맵으로 연결됩니다.',
  },
  {
    name: 'robots.txt',
    href: '/robots.txt',
    desc: '검색·AI 크롤러 접근 규칙과 사이트맵 위치를 안내합니다.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE}/feeds/#webpage`,
  name: '구독 · 피드 (RSS·Atom·JSON)',
  description:
    '지원금가이드의 새 글을 RSS·Atom·JSON Feed로 구독하세요. 신규 지원금 채널과 AI·검색 엔진용 파일도 제공합니다.',
  url: `${SITE}/feeds/`,
  inLanguage: 'ko-KR',
  isPartOf: { '@id': `${SITE}/#website` },
  publisher: { '@id': `${SITE}/#organization` },
};
---

<BaseLayout
  title="구독 · 피드 (RSS·Atom·JSON) — 지원금가이드"
  description="지원금가이드의 새 글을 RSS·Atom·JSON Feed로 구독하세요. 신규 지원금 채널과 llms.txt·사이트맵 등 AI·검색 엔진용 파일도 제공합니다."
  breadcrumbs={[
    { name: '홈', href: '/' },
    { name: '구독 · 피드', href: '/feeds/' },
  ]}
>
  <Container size="narrow">
    <article class="page">
      <h1>구독 · 피드</h1>
      <p class="meta">RSS · Atom · JSON Feed · AI/검색 엔진용 파일</p>
      <p class="intro">
        지원금가이드의 새 글을 원하는 방식으로 받아보세요. 매일 올라오는 정책 이슈와 새로
        등록되는 정부 지원금을 채널별로 구독할 수 있고, AI·검색 엔진용 파일도 함께 제공합니다.
        피드 주소를 복사해 RSS 리더에 붙여넣으면 됩니다.
      </p>

      <section>
        <h2>구독 피드</h2>
        <ul class="cards">
          {
            feeds.map((f) => (
              <li class="card">
                <div class="card-head">
                  <a href={f.href}>{f.name}</a>
                  <span class="badge">{f.badge}</span>
                </div>
                <p>{f.desc}</p>
                <code>{SITE}{f.href}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>카테고리별 RSS</h2>
        <p class="sub">
          관심 분야의 이슈 글만 골라 구독하세요. 전체 이슈 RSS의 카테고리 필터판입니다.
        </p>
        <ul class="cat-list">
          {
            categoryFeeds.map((c) => (
              <li class="cat-item">
                <a href={c.href}>
                  {c.ko} 이슈 <span class="badge">RSS</span>
                </a>
                <code>{SITE}{c.href}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>AI · 검색 엔진용 파일</h2>
        <p class="sub">
          AI 어시스턴트와 검색 크롤러가 사이트를 정확히 이해하도록 표준 파일을 공개합니다.
        </p>
        <ul class="cards">
          {
            machineFiles.map((f) => (
              <li class="card">
                <div class="card-head">
                  <a href={f.href}>{f.name}</a>
                </div>
                <p>{f.desc}</p>
                <code>{SITE}{f.href}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>구독하는 법</h2>
        <p>
          <strong>1단계:</strong> 위 피드 중 원하는 채널의 주소를 복사합니다.
        </p>
        <p>
          <strong>2단계:</strong> Feedly·Inoreader 같은 RSS 리더나 이메일 구독 서비스의
          "피드 추가"에 주소를 붙여넣습니다.
        </p>
        <p>
          <strong>3단계:</strong> 새 글이 올라오면 자동으로 받아볼 수 있습니다. 브라우저에서
          주소를 직접 열면 원본 피드 내용도 확인할 수 있습니다.
        </p>
        <p class="note">
          피드 관련 문의는 <a href="mailto:smartdatashop@gmail.com">smartdatashop@gmail.com</a>으로
          알려주세요.
        </p>
      </section>
    </article>
  </Container>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
</BaseLayout>

<style>
  .page {
    padding: 64px 0 96px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .meta {
    font-size: 13px;
    color: var(--text-2);
    margin: 0 0 24px;
  }
  .intro {
    color: var(--text-2);
    line-height: 1.7;
    margin: 0 0 40px;
  }
  section {
    margin-bottom: 40px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .sub {
    color: var(--text-2);
    line-height: 1.7;
    margin: 0 0 16px;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 12px;
  }
  .card {
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 12px;
    padding: 16px 18px;
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .card-head a {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-1, #111827);
    text-decoration: none;
  }
  .card-head a:hover {
    text-decoration: underline;
  }
  .badge {
    font-size: 11px;
    font-weight: 700;
    color: #1d4ed8;
    background: #eff6ff;
    border-radius: 999px;
    padding: 2px 8px;
  }
  .card p {
    color: var(--text-2);
    line-height: 1.6;
    font-size: 14px;
    margin: 0 0 10px;
  }
  .card code {
    display: inline-block;
    font-size: 12px;
    color: var(--text-2);
    background: var(--bg-2, #f9fafb);
    border-radius: 6px;
    padding: 4px 8px;
    word-break: break-all;
  }
  .cat-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .cat-item {
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 10px;
    padding: 12px 14px;
  }
  .cat-item a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-1, #111827);
    text-decoration: none;
  }
  .cat-item a:hover {
    text-decoration: underline;
  }
  .cat-item code {
    display: block;
    font-size: 12px;
    color: var(--text-2);
    margin-top: 6px;
    word-break: break-all;
  }
  section p {
    color: var(--text-2);
    line-height: 1.7;
    margin: 0 0 10px;
  }
  .note {
    font-size: 14px;
    margin-top: 16px;
  }
</style>
