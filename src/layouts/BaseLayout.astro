---
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import HotkeyNav from '@/components/HotkeyNav.astro';
import TopBar from '@/components/TopBar.astro';
import { buildBreadcrumb, buildOrganization, buildWebSite, type BreadcrumbItem } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** head <meta name="keywords"> — tags 최대 8개 (네이버 신호, 구글 무해) */
  keywords?: string[];
  noindex?: boolean;
  /** 활성 nav 키: 'home' | '/subsidies' | '/guide' 등 */
  activeNav?: string;
  /** 페이지별 breadcrumb — 명시 시 BreadcrumbList JSON-LD 자동 출력 */
  breadcrumbs?: BreadcrumbItem[];
  /** Cycle #18: og:type override — 'article' for 영구 포스트, 'website' default */
  ogType?: 'website' | 'article' | 'profile';
  /** og:type=article 시 추가 메타 (article:published_time, author 등) */
  ogArticle?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  keywords,
  noindex = false,
  activeNav = '',
  breadcrumbs,
  ogType = 'website',
  ogArticle,
} = Astro.props;

// breadcrumbSchema에 @id 부여 (canonical URL + #breadcrumb) — entity 그래프 강화 (Cycle #4 P0-5)
const canonicalPath = canonical ?? Astro.url.pathname;
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 1 ? buildBreadcrumb(breadcrumbs, canonicalPath) : null;

// 사이트와이드 entity — 모든 페이지에 1회 노출 (Organization + WebSite, @id 앵커로 다른 schema에서 참조)
const orgSchema = buildOrganization();
const siteSchema = buildWebSite();

// Cycle #24: SiteNavigationElement schema — TopBar 주요 메뉴 + 핵심 hub 진입점 명시
// Google sitelinks 자격 + AI 답변 엔진 사이트 구조 인지
const siteNavigation = {
  '@context': 'https://schema.org',
  '@type': 'SiteNavigationElement',
  '@id': 'https://awoo.or.kr/#sitenav',
  name: 'Main Navigation',
  hasPart: [
    { '@type': 'WebPage', name: '홈', url: 'https://awoo.or.kr/' },
    { '@type': 'WebPage', name: '오늘의 이슈', url: 'https://awoo.or.kr/issues/' },
    { '@type': 'WebPage', name: '지원금', url: 'https://awoo.or.kr/subsidies/' },
    { '@type': 'WebPage', name: '가이드', url: 'https://awoo.or.kr/guide/' },
    { '@type': 'WebPage', name: '5분 진단', url: 'https://awoo.or.kr/quick/' },
    { '@type': 'WebPage', name: '페르소나별', url: 'https://awoo.or.kr/personas/' },
    { '@type': 'WebPage', name: '상황별', url: 'https://awoo.or.kr/situations/' },
    { '@type': 'WebPage', name: '주제별', url: 'https://awoo.or.kr/topics/' },
    { '@type': 'WebPage', name: '지역별', url: 'https://awoo.or.kr/regions/' },
    { '@type': 'WebPage', name: '용어 사전', url: 'https://awoo.or.kr/glossary/' },
  ],
};

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();
const siteName = '지원금가이드';

// AdSense 로더는 정책·약관 페이지와 noindex(404·thin) 페이지에는 주입하지 않는다.
// (ads-policy "광고 미게재 영역" 약속을 코드로 강제 + AdSense 정책페이지 광고 금지 준수)
const POLICY_PATHS = new Set([
  '/privacy/', '/cookies/', '/terms/', '/about/', '/contact/', '/ads-policy/', '/editorial-policy/',
  '/editor/jjh/', // ads-policy가 "편집책임자 프로필 미게재"를 약속 — 코드로 강제
]);
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const showAds = !noindex && !POLICY_PATHS.has(normalizedPath);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Google Analytics 4 (gtag.js) — 전 페이지 사이트와이드 측정.
        CSP: script-src에 googletagmanager, connect-src에 google-analytics 허용 필요 (public/_headers). */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3VBB7V08LJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-3VBB7V08LJ');
    </script>

    {/* Google AdSense — 사이트 소유권 확인 + 광고 게재.
        정책·약관 페이지와 noindex(404·thin) 페이지에는 미주입 (showAds 가드).
        CSP: script-src/connect-src/frame-src 에 googlesyndication·doubleclick 허용 (public/_headers). */}
    {showAds && (
      <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7830821732287404" crossorigin="anonymous"></script>
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.slice(0, 8).join(', ')} />}
    {/* v2: news_keywords — Google News/뉴스면 토픽 매핑 신호 (article 한정, keywords와 동일 소스) */}
    {ogType === 'article' && keywords && keywords.length > 0 && (
      <meta name="news_keywords" content={keywords.slice(0, 8).join(', ')} />
    )}
    {ogType === 'article' && <meta name="author" content={ogArticle?.author ?? '김준혁'} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Cycle #30: PWA manifest — Chrome installable, 빠른 재방문 신호 */}
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* iOS는 SVG apple-touch-icon 미지원 — 빌드 시 favicon.svg에서 180px PNG 생성(generate-og-images.mjs) */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* 피드 — RSS·Atom·JSON 구독 채널 (전체 안내: /feeds) */}
    <link rel="alternate" type="application/rss+xml" title="신규 정부 지원금" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="오늘의 이슈 포스트" href="/feed-issues.xml" />
    <link rel="alternate" type="application/atom+xml" title="오늘의 이슈 포스트 (Atom)" href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title="오늘의 이슈 포스트 (JSON Feed)" href="/feed.json" />

    {/* 검색엔진 사이트 인증 — 등록 시 docs/ops/SEARCH-CONSOLE.md / NAVER-SEARCH-ADVISOR.md 참조
        DNS TXT 권장 (이중 인증 시 메타 태그도 함께)
        Google: <meta name="google-site-verification" content="..." />
        Naver:  <meta name="naver-site-verification" content="..." />  */}

    {/* Pretendard 폰트는 preload 안 함 — Pretendard Adjusted(size-adjust) fallback이
        먼저 그려지고 woff2 로드 후 CLS 없이 swap. preload하면 모바일 LCP가
        font 다운로드를 기다리느라 지연됨 (300KB / Slow 4G = ~1.5s 페널티). */}

    {/* noindex여도 follow 유지 — 페이지네이션(/issues/all/2+)이 nofollow면 뒤 페이지에만
        실린 포스트로 가는 크롤 경로가 끊긴다. 색인 차단과 링크 발견은 별개 신호. */}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && (
      <Fragment>
        {/* Discover·검색 결과에서 큰 이미지 미리보기 허용 (썸네일 → 와이드 카드) */}
        <meta name="robots" content="max-image-preview:large, max-snippet:-1" />
        <meta name="googlebot" content="max-image-preview:large, max-snippet:-1" />
      </Fragment>
    )}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />

    {/* Cycle #18 P0: og:type=article 시 Article 전용 메타 (영구 포스트) */}
    {ogType === 'article' && ogArticle && (
      <Fragment>
        {ogArticle.publishedTime && <meta property="article:published_time" content={ogArticle.publishedTime} />}
        {ogArticle.modifiedTime && <meta property="article:modified_time" content={ogArticle.modifiedTime} />}
        {ogArticle.author && <meta property="article:author" content={ogArticle.author} />}
        {ogArticle.section && <meta property="article:section" content={ogArticle.section} />}
        {ogArticle.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </Fragment>
    )}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#0071e3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    {/* 다크모드 깜빡임 방지 — 첫 페인트 전 테마 결정 */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
    <meta name="naver-site-verification" content="8203ca7628a4c7bc8b90fb2086b0086ec3c62ac9" />

    {/* 사이트와이드 entity — 모든 페이지 1회. AI 인용·지식 그래프·sitelinks 신호. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {/* Cycle #24: 사이트 메뉴 구조 (sitelinks + AI 답변 엔진 사이트맵 인지) */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteNavigation)} />

    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <TopBar active={activeNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <HotkeyNav />

    {/* Web Vitals beacon — idle 시점에 import (TBT 측정창 안에 들어가지 않게) */}
    <script>
      const _initVitals = () => import('@/lib/vitals').then((m) => m.initVitals()).catch(() => {});
      if ('requestIdleCallback' in window) {
        (window as Window).requestIdleCallback(_initVitals, { timeout: 3000 });
      } else {
        setTimeout(_initVitals, 2500);
      }
    </script>

    {/* Naver Analytics (wcslog) — 닫는 body 직전.
        CSP: script-src에 wcs.pstatic.net, connect-src에 wcs.naver.net 허용 필요 (public/_headers). */}
    <script is:inline type="text/javascript" src="https://wcs.pstatic.net/wcslog.js"></script>
    <script is:inline type="text/javascript">
      window.wcs_add = window.wcs_add || {};
      window.wcs_add['wa'] = 'cf391d9a2fff08';
      if (window.wcs) {
        window.wcs_do();
      }
    </script>
  </body>
</html>
