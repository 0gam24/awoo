{
  "name": "awoo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "지원금가이드 — 정부 지원금 안내 사이트 (운영: 스마트데이터샵)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run generate:mirror && npm run generate:og",
    "build": "node scripts/build-entity-graph.mjs && astro build && node scripts/check-bundle-size.mjs",
    "build:graph": "node scripts/build-entity-graph.mjs",
    "generate:mirror": "node scripts/generate-network-mirror.mjs",
    "generate:og": "node scripts/generate-og-images.mjs",
    "update:today": "node scripts/update-today-md.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "lint:content": "node scripts/lint-content.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --collect.settings.preset=mobile",
    "verify": "npm run lint && npm run lint:content && npm run check && npm run build && npm run lhci",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "sync:subsidies": "node scripts/sync-subsidies.mjs",
    "sync:subsidies:new": "node scripts/sync-subsidies.mjs new",
    "sync:subsidies:bootstrap": "node scripts/sync-subsidies.mjs bootstrap",
    "sync:issues": "node scripts/sync-issues.mjs",
    "publish:scheduled": "node scripts/publish-scheduled.mjs",
    "sync:history": "node scripts/sync-history.mjs",
    "radar:sync": "node scripts/keyword-radar.mjs",
    "sweep:stale": "node scripts/sweep-stale.mjs",
    "sweep:stale:apply": "node scripts/sweep-stale.mjs --apply",
    "tag:personas": "node scripts/tag-personas.mjs",
    "tag:personas:apply": "node scripts/tag-personas.mjs --apply",
    "check:apply-urls": "node scripts/check-apply-urls.mjs",
    "check:apply-urls:all": "node scripts/check-apply-urls.mjs --all",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "citations:track": "node scripts/citation-tracker.mjs",
    "cycle:status": "node scripts/cycle-runner.mjs status",
    "cycle:advance": "node scripts/cycle-runner.mjs advance",
    "cycle:reset": "node scripts/cycle-runner.mjs reset",
    "audit:links": "node scripts/internal-link-audit.mjs",
    "audit:schema": "node scripts/schema-validate.mjs",
    "audit:llms": "node scripts/llms-freshness.mjs",
    "audit:keywords": "node scripts/keyword-coverage.mjs",
    "audit:headings": "node scripts/audit-headings.mjs",
    "audit:skip-link": "node scripts/audit-skip-link.mjs",
    "audit:a11y": "npm run audit:headings && npm run audit:skip-link",
    "audit:rss": "node scripts/audit-rss.mjs",
    "audit:titles": "node scripts/audit-titles.mjs",
    "audit:specificity": "node scripts/audit-specificity.mjs",
    "audit:content-depth": "node scripts/audit-content-depth.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.2.2",
    "@astrojs/react": "5.0.4",
    "@astrojs/sitemap": "3.7.2",
    "@tailwindcss/vite": "4.2.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "astro": "6.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.4.13",
    "@lhci/cli": "0.15.1",
    "@resvg/resvg-js": "2.6.2",
    "lefthook": "2.1.6",
    "satori": "0.29.0",
    "typescript": "5.9.3",
    "web-vitals": "5.2.0",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
